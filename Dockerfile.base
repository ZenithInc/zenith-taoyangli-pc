ARG PHP_RUNTIME_IMAGE=registry.taoyangli.cn/taoyangli/php80-security:6847cec66699ef1bc46276bb48dada7d77b3801c@sha256:80992d1d59715c463615c1a42c930e1d08f5e0ca61de1f43d69603f9b74d7640
FROM ${PHP_RUNTIME_IMAGE}
RUN php /usr/local/lib/php-runtime-check.php

LABEL maintainer="douya" version="1.0" type="base-with-dependencies"

RUN apk add tzdata && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
&& echo "Asia/Shanghai" > /etc/timezone \
&& apk del tzdata

# update
RUN set -ex \
    && apk update \
    && cd /etc/php8 \
    # - config PHP
    && { \
        echo "upload_max_filesize=128M"; \
        echo "post_max_size=128M"; \
        echo "memory_limit=1024M"; \
        echo "date.timezone=Asia/Shanghai"; \
    } | tee conf.d/php8-overrides.ini \
    # ---------- clear works ----------
    && rm -rf /var/cache/apk/* /tmp/* /usr/share/man \
    && echo -e "\033[42;37m Build Completed :).\033[0m\n"

WORKDIR /data/project

# Copy only dependency files for composer install
COPY composer.json composer.lock ./

# Install dependencies without dev packages
RUN composer install --no-dev -o --no-scripts --no-autoloader \
    && rm -rf /root/.composer

# Generate optimized autoloader (will be regenerated in final image with actual code)
RUN composer dump-autoload --no-dev -o
